// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum GlobalRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  PENDING
  DELETED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  FACEBOOK
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  OTP_LOGIN
}

model User {
  id                      Int                  @id @default(autoincrement())
  uuid                    String               @unique @db.Char(36)
  email                   String               @unique @db.VarChar(255)
  globalRole              GlobalRole           @default(USER) @map("global_role")
  status                  UserStatus           @default(ACTIVE)
  twoFactorEnabled        Boolean              @default(false) @map("two_factor_enabled")
  twoFactorSecret         String?              @db.Text @map("two_factor_secret")
  twoFactorBackupCodes    Json?                @map("two_factor_backup_codes")
  lastLoginAt             DateTime?            @map("last_login_at")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  deletedAt               DateTime?            @map("deleted_at")
  
  // Relations
  profile                 UserProfile?
  authAccounts            AuthAccount[]
  sessions                UserSession[]
  verificationTokens      VerificationToken[]
  ownedSpaces             Space[]              @relation("OwnedSpaces")
  memberships             SpaceMember[]        @relation("UserMemberships")
  invitesCreated          SpaceInvite[]        @relation("InvitesCreated")
  membersInvited          SpaceMember[]        @relation("MembersInvited")

  @@map("users")
}

model UserProfile {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique @map("user_id")
  displayName String?   @db.VarChar(100) @map("display_name")
  username    String?   @unique @db.VarChar(50)
  avatarUrl   String?   @db.Text @map("avatar_url")
  bio         String?   @db.Text
  birthdate   DateTime? @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model AuthAccount {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  provider       AuthProvider
  providerUserId String?      @db.VarChar(255) @map("provider_user_id")
  providerEmail  String?      @db.VarChar(255) @map("provider_email")
  passwordHash   String?      @db.Text @map("password_hash")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relations
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], name: "uq_provider_account")
  @@map("auth_accounts")
}

model UserSession {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  refreshTokenHash String    @db.VarChar(255) @map("refresh_token_hash")
  deviceName       String?   @db.VarChar(255) @map("device_name")
  ipAddress        String?   @db.VarChar(45) @map("ip_address")
  userAgent        String?   @db.Text @map("user_agent")
  rememberMe       Boolean   @default(false) @map("remember_me")
  lastUsedAt       DateTime? @map("last_used_at")
  expiredAt        DateTime  @map("expired_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model VerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenType TokenType @map("token_type")
  token     String    @unique @db.VarChar(255)
  expiredAt DateTime  @map("expired_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenType], name: "idx_verification_user_type")
  @@map("verification_tokens")
}

enum SpaceVisibility {
  PRIVATE
  PUBLIC
}

enum SpaceType {
  PERSONAL
  COUPLE
  FAMILY
  FRIENDS
}

enum SpaceRole {
  OWNER
  ADMIN
  CONTRIBUTOR
  VIEWER
}

enum SpaceMemberStatus {
  PENDING
  ACTIVE
  REJECTED
}

model Space {
  id          Int             @id @default(autoincrement())
  uuid        String          @unique @db.Char(36)
  name        String          @db.VarChar(255)
  slug        String          @unique @db.VarChar(255)
  description String?         @db.Text
  avatarUrl   String?         @db.Text @map("avatar_url")
  coverUrl    String?         @db.Text @map("cover_url")
  type        SpaceType       @default(FRIENDS)
  visibility  SpaceVisibility @default(PUBLIC)
  ownerId     Int             @map("owner_id")
  themeKey    String          @default("default") @map("theme_key")
  layoutKey   String          @default("timeline") @map("layout_key")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  // Relations
  owner       User            @relation("OwnedSpaces", fields: [ownerId], references: [id])
  members     SpaceMember[]
  invites     SpaceInvite[]

  @@map("spaces")
}

model SpaceMember {
  id                 Int               @id @default(autoincrement())
  spaceId            Int               @map("space_id")
  userId             Int               @map("user_id")
  role               SpaceRole         @default(CONTRIBUTOR)
  status             SpaceMemberStatus @default(ACTIVE)
  joinRequestMessage String?           @db.Text @map("join_request_message")
  joinedAt           DateTime?         @map("joined_at")
  invitedBy          Int?              @map("invited_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at")

  // Relations
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User      @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  inviter   User?     @relation("MembersInvited", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([spaceId, userId], name: "uq_space_user")
  @@map("space_members")
}

model SpaceInvite {
  id               Int       @id @default(autoincrement())
  spaceId          Int       @map("space_id")
  role             SpaceRole @default(CONTRIBUTOR)
  token            String    @unique @db.VarChar(255)
  email            String?   @db.VarChar(255)
  message          String?   @db.Text
  requiresApproval Boolean   @default(true) @map("requires_approval")
  isRevoked        Boolean   @default(false) @map("is_revoked")
  expiresAt        DateTime  @map("expires_at")
  createdBy        Int       @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creator   User      @relation("InvitesCreated", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([spaceId, expiresAt], name: "idx_space_invites_lookup")
  @@map("space_invites")
}